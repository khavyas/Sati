@model Sati.Models.StoneProductionViewModel
@{
    ViewBag.Title = "Create Stone Production";
}

<h2>Create Production Record</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@using (Html.BeginForm("Create", "StoneProduction", FormMethod.Post))
{
    <div class="form-group">
        @Html.LabelFor(model => model.StoneName)
        @Html.TextBoxFor(model => model.StoneName, new { @class = "form-control" })
    </div>

    @if (Model.StoneProductions != null && Model.StoneProductions.Any())
    {
        @for (int i = 0; i < Model.StoneProductions.Count; i++)
        {
            var productionStep = Model.StoneProductions[i].ProductionStep;
            if (productionStep != null)
            {
                <div class="form-group">
                    <label>@productionStep.StepName</label>
                    @Html.DropDownListFor(
                            model => model.StoneProductions[i].Status,
                            new SelectList(new[] { "NotStarted", "InProgress", "Complete", "Skipped", "Damaged", "Broke" }),
                            new { @class = "form-control", onchange = $"updateStepStatus({Model.StoneProductions[i].StoneProductionId}, this.value)" }
                            )
                </div>
            }
        }
    }

    <button type="submit" class="btn btn-primary" style="margin-top: 20px;">Create</button>
}

<hr />

<h2>Search Stone Production Status and Track the Progress.</h2>
@using (Html.BeginForm("Search", "StoneProduction", FormMethod.Get, new { id = "searchForm" }))
{
    <div class="form-group">
        @Html.LabelFor(model => model.SearchStoneName, "Search by Stone Name")
        @Html.TextBoxFor(model => model.SearchStoneName, new { @class = "form-control", id = "searchStoneName" })
    </div>
    <button type="submit" class="btn btn-primary" style="margin-top: 20px;">Search</button>
    <button type="button" class="btn btn-secondary" style="margin-top: 20px; margin-left: 10px;" onclick="clearSearch()">Clear</button>
    <br />

    <!-- Table and No Records Message HTML -->
    @if (Model.StoneProductionTableData != null && Model.StoneProductionTableData.Any())
    { 
        <div id="tableContainer">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Stone ID</th>
                        <th>Stone Name</th>
                        @foreach (var step in Model.ProductionSteps)
                        {
                            <th>@step.StepName</th>
                        }
                        <th>Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.StoneProductionTableData)
                    {
                        <tr>
                            <td>@item.StoneId</td>
                            <td>@item.StoneName</td>
                            @foreach (var status in item.ProductionStatuses)
                            {
                                <td>@status</td>
                            }
                            <td>
                                <button type="button" class="btn btn-secondary" onclick="openEditModal(@item.StoneId, '@item.StoneName')">Edit</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.SearchStoneName))
    {
        <div id="noRecordsMessage" class="no-records-box">
            <p>No records found.</p>
        </div>
    }
}

<!-- Modal HTML -->
<div id="editModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalLabel">Edit Stone Production</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @using (Html.BeginForm("EditStoneProduction", "StoneProduction", FormMethod.Post, new { id = "editForm" }))
                {
                    @Html.Hidden("StoneId", "") <!-- This hidden field will store the actual StoneId -->
                    <div class="form-group">
                        @Html.Label("Stone ID")
                        @Html.TextBox("StoneIdDisplay", "", new { @class = "form-control", @readonly = "readonly" }) <!-- Read-only field to display StoneId -->
                    </div>
                    <div class="form-group">
                        @Html.Label("Stone Name")
                        @Html.TextBox("StoneName", "", new { @class = "form-control", @readonly = "readonly" })
                    </div>
                    <div id="productionStepsContainer"></div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="$('#editForm').submit();">Save changes</button>
            </div>
        </div>
    </div>
</div>


<script>
    function openEditModal(stoneId, stoneName) {
        // Populate the modal with the data
        $('#editModal #StoneId').val(stoneId); // Hidden field
        $('#editModal #StoneIdDisplay').val(stoneId); // Read-only display field
        $('#editModal #StoneName').val(stoneName);

        // Fetch the production steps and statuses via AJAX
        $.ajax({
            url: '@Url.Action("GetStoneProductionSteps", "StoneProduction")',
            type: 'GET',
            data: { stoneId: stoneId },
            success: function (response) {
                $('#productionStepsContainer').html(response);
                $('#editModal').modal('show');
            }
        });
    }

    function clearSearch() {
        // Clear the search text box
        $('#searchStoneName').val('');

        // Clear the "No records found" message, if present
        $('#noRecordsMessage').remove();

        // Clear the table content, if present
        $('#tableContainer').remove();
    }

</script>


<style>
    .no-records-box {
        border: 1px solid #f5c6cb;
        background-color: #f8d7da;
        color: #721c24;
        padding: 10px;
        border-radius: 5px;
        margin-top: 10px;
    }
</style>
